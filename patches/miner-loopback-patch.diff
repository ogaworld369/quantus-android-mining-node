diff --git a/node/src/miner_server.rs b/node/src/miner_server.rs
index d8003eb..c9b4b1b 100644
--- a/node/src/miner_server.rs
+++ b/node/src/miner_server.rs
@@ -590,7 +590,14 @@ fn create_server_endpoint(
 	quinn_config.transport_config(Arc::new(transport_config));
 
 	// Create endpoint
-	let addr = format!("0.0.0.0:{}", port).parse().unwrap();
+	// Android build patch (miner-loopback): bind to loopback only.
+	// Upstream binds 0.0.0.0, which exposes this endpoint to the whole
+	// LAN; the only miner the Android build ever serves is the one
+	// bundled in the same app, connecting from the same device. The
+	// auth token stays in place and is what authenticates a client to
+	// this node; the TLS certificate pin works the other way round: it
+	// lets the miner authenticate this node before it sends the token.
+	let addr = format!("127.0.0.1:{}", port).parse().unwrap();
 	let endpoint = quinn::Endpoint::server(quinn_config, addr)
 		.map_err(|e| format!("Failed to create server endpoint: {}", e))?;
 
